{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blendsmith.dev/schemas/owner_action_required.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "failure_category", "retryable", "failed_operation", "attempts", "retries", "last_healthy_state", "requested_owner_action", "resume_hint", "final_safety_status"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "failure_category": {"type": "string", "minLength": 1},
    "retryable": {"type": "boolean"},
    "failed_operation": {"type": "string", "minLength": 1},
    "attempts": {"type": "integer", "minimum": 1, "maximum": 4},
    "retries": {"type": "integer", "minimum": 0, "maximum": 3},
    "last_healthy_state": {"type": "string", "minLength": 1},
    "checkpoint": {"type": ["string", "null"]},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "requested_owner_action": {"type": "string", "minLength": 1},
    "resume_hint": {"type": "string", "minLength": 1},
    "final_safety_status": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
