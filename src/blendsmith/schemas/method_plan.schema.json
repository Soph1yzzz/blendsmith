{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blendsmith.dev/schemas/method_plan.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "plan_id", "work_units"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "work_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["work_unit_id", "intent", "requirements"],
        "properties": {
          "work_unit_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "intent": {"type": "string", "minLength": 1, "maxLength": 256},
          "requirements": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "notes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
