{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blendsmith.dev/schemas/run.schema.json",
  "type": "object",
  "required": ["schema_version", "run_id", "project_id", "state", "created_at", "updated_at", "iteration", "active_candidate_id"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "state": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "iteration": {"type": "integer", "minimum": 0},
    "active_candidate_id": {"type": ["string", "null"]},
    "resume_state": {"type": ["string", "null"]},
    "assurance_level": {"enum": [null, "render_verified", "live_gui_verified"]},
    "accepted_candidate_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "active_checkpoint_id": {"type": ["string", "null"]},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
