{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blendsmith.dev/schemas/domain_practice.schema.json",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rule": {
      "type": "object",
      "required": ["rule_id", "category", "requirement", "rationale", "finding_ids", "confidence", "verification"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "category": {"enum": ["FUNCTION", "DIMENSION", "STRUCTURE", "PROCESS", "PLACEMENT", "MATERIAL", "SAFETY", "REGULATION", "OTHER"]},
        "requirement": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "finding_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "verification": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "ignored_finding": {
      "type": "object",
      "required": ["finding_id", "reason"],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "knowledge_sha256",
    "practice_id",
    "domain",
    "rules",
    "ignored_findings"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "knowledge_sha256": {"$ref": "#/$defs/sha256"},
    "practice_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "domain": {"type": "string", "minLength": 1, "maxLength": 256},
    "rules": {
      "type": "array",
      "items": {"$ref": "#/$defs/rule"}
    },
    "ignored_findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/ignored_finding"}
    }
  },
  "additionalProperties": false
}
