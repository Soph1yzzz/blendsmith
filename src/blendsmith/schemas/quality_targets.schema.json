{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blendsmith.dev/schemas/quality_targets.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "targets",
    "geometry_checks",
    "geometry_check_rationale"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "target_id",
          "reference_id",
          "reference_sha256",
          "part",
          "features",
          "view_keys",
          "priority",
          "inferred"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "reference_id": {
            "type": "string",
            "minLength": 1
          },
          "reference_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "part": {
            "type": "string",
            "minLength": 1
          },
          "features": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "view_keys": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "priority": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "NORMAL"
            ]
          },
          "inferred": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "geometry_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "source_objects",
          "target_objects",
          "max_distance_mm",
          "min_source_vertices"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "source_objects": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "target_objects": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "max_distance_mm": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000
          },
          "min_source_vertices": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "geometry_check_rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
