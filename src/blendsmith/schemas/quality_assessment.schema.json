{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blendsmith.dev/schemas/quality_assessment.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "candidate_id",
    "candidate_sha256",
    "targets_sha256",
    "compared_to_sha256",
    "creator_context_id",
    "reviewer_context_id",
    "opened_evidence",
    "target_results",
    "decision",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "targets_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "compared_to_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "creator_context_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_context_id": {
      "type": "string",
      "minLength": 1
    },
    "opened_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "target_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "target_id",
          "view_keys",
          "observations",
          "fidelity",
          "delta",
          "confidence"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "view_keys": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "observations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fidelity": {
            "enum": [
              "MATCH",
              "ACCEPTABLE_DEVIATION",
              "MISMATCH"
            ]
          },
          "delta": {
            "enum": [
              "BASELINE",
              "IMPROVED",
              "UNCHANGED",
              "REGRESSED",
              "INCOMPARABLE"
            ]
          },
          "confidence": {
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "decision": {
      "enum": [
        "PROMOTE",
        "HOLD"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
